{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "CacheRefreshSeconds": 2,
    "HttpHandlerLifetimeSeconds": 30,
    "ConnectionLifetimeSeconds": 120,
    "DataProtectionPurpose": "PCSTORE.API.AiProviderSettings.v1",
    "LegacyDataProtectionPurpose": "PCSTORE.API.SystemConfiguration.v1",
    "PrivacyReplacement": "[đã ẩn]",
    "CircuitFailureThreshold": 3,
    "CircuitOpenSeconds": 60,
    "HealthCheckIntervalSeconds": 30,
    "LegacySettingKeys": {
      "ApiKey": "system.ai.api-key",
      "Model": "system.ai.model",
      "Temperature": "system.ai.temperature",
      "MaxTokens": "system.ai.max-tokens"
    },
    "Tasks": {
      "ExtractIntent": {
        "Temperature": 0.1,
        "NumPredict": 200,
        "MaxRepairInputCharacters": 2000,
        "MaxCustomerMessageCharacters": 4000
      },
      "ExplainSelection": {
        "MaxWords": 120
      }
    },
    "Ollama": {
      "HttpClientName": "pcstore-ollama",
      "BaseUrl": "http://127.0.0.1:11434",
      "ModelName": "qwen2.5:7b",
      "KeepAlive": "30m",
      "NumCtx": 4096,
      "TimeoutSeconds": 120,
      "ConnectTimeoutSeconds": 3,
      "HealthTimeoutSeconds": 5,
      "GeneratePath": "/api/generate",
      "HealthPath": "/api/tags",
      "WarmUpPrompt": "ping",
      "WarmUpNumPredict": 1,
      "IsMaintenanceMode": false
    },
    "Gemini": {
      "HttpClientName": "pcstore-gemini",
      "ApiKey": "",
      "ModelName": "gemini-3.8-flash",
      "FallbackModelNames": [ "gemini-3.6-flash", "gemini-3.5-flash-lite" ],
      "RetiredModelNames": [ "gemini-2.0-flash", "gemini-2.0-flash-001", "gemini-2.0-flash-lite", "gemini-2.0-flash-lite-001", "gemini-1.5-flash", "gemini-1.5-pro" ],
      "BaseUrl": "https://generativelanguage.googleapis.com",
      "ApiVersion": "v1beta",
      "ApiKeyHeaderName": "x-goog-api-key",
      "GeneratePathSuffix": ":generateContent",
      "StreamPathSuffix": ":streamGenerateContent",
      "StreamQuery": "alt=sse",
      "TimeoutSeconds": 30,
      "ConnectTimeoutSeconds": 3,
      "HealthTimeoutSeconds": 8,
      "Temperature": 0.4,
      "MaxOutputTokens": 512,
      "IsEnabled": true
    }
  },
  "Faq": {
    "MinimumScore": 0.45,
    "KeywordWeight": 0.7,
    "QuestionWeight": 0.3,
    "PageSize": 10,
    "MaxPageSize": 50,
    "MaxImportItems": 200,
    "MaxCategoryLength": 80,
    "MaxQuestionLength": 300,
    "MaxAnswerLength": 2000,
    "MaxAnswerWords": 80,
    "MaxKeywordsLength": 800,
    "MaxPriority": 1000,
    "PlaceholderMarker": "[CẦN ĐIỀN]",
    "UnfilledCustomerMessage": "Cửa hàng chưa công bố nội dung này. Bạn vui lòng hỏi nhân viên để biết thông tin chính xác.",
    "CacheSeconds": 30,
    "CsrfHeaderName": "X-CSRF-Token",
    "CsrfLifetimeMinutes": 120,
    "AccessTokenPurpose": "PCSTORE.API.AccessToken.v1",
    "AllowedOrigins": [ "http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5170", "http://127.0.0.1:5170" ]
  }
}
